# Copie este archivo como .env y ajuste los valores.

# MySQL (cree antes la base con sql/crear_base_mysql.sql)
DATABASE_URL=mysql+pymysql://root:tu_password@localhost:3306/sysemerg_v2?charset=utf8mb4
# Para probar sin MySQL puede usar SQLite:
# DATABASE_URL=sqlite:///./emergencias.db

PORT=8000
DEBUG_MODE=True

# Usuario administrador que se crea la primera vez
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=1234password

# Clave para firmar los tokens JWT (cámbiela por una cadena larga y aleatoria)
JWT_SECRET=cambie-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRE_MINUTES=480

# Direcciones del frontend permitidas (separadas por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Despachar unidades automáticamente al recibir un reporte
AUTO_DISPATCH=True
# Cargar flota, historial y operadores de ejemplo (op.incidentes, op.flota, op.red)
SEED_DEMO_DATA=True
DEMO_USERS_PASS=operador2026
