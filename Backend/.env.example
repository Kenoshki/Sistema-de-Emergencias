# Copie este archivo como .env y ajuste los valores (desarrollo local).
# En producción (Railway) estas variables se definen en el panel; vea ../RAILWAY.md

# MySQL (cree antes la base con sql/crear_base_mysql.sql)
DATABASE_URL=mysql+pymysql://root:tu_password@localhost:3306/sysemerg_v2?charset=utf8mb4
# Para probar sin MySQL puede usar SQLite:
# DATABASE_URL=sqlite:///./emergencias.db

PORT=8000
# True solo en su computadora. En producción déjelo en False: así el arranque EXIGE
# secretos propios, se ocultan /docs y se activan las cabeceras HSTS.
DEBUG_MODE=True

# Usuario administrador que se crea la primera vez (mín. 10 caracteres, no use el de ejemplo en producción)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=cambie-esta-clave-larga
# Correo del administrador: necesario para «¿Olvidó su contraseña?»
DEFAULT_ADMIN_EMAIL=admin@su-dominio.com

# Clave para firmar los tokens JWT, mínimo 32 caracteres. Genere una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=genere-una-clave-larga-y-aleatoria-de-al-menos-32-caracteres
JWT_EXPIRE_MINUTES=240

# Direcciones del frontend permitidas (separadas por coma, sin / final)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Dirección pública del frontend (se usa en el enlace del correo de recuperación)
FRONTEND_URL=http://localhost:5173

# Despachar unidades automáticamente al recibir un reporte
AUTO_DISPATCH=True
# Prioridad máxima que puede declarar un ciudadano (1-4)
PUBLIC_MAX_PRIORITY=3
# Cargar flota, historial y operadores de ejemplo (op.incidentes, op.flota, op.red) SOLO para demostración
SEED_DEMO_DATA=True
DEMO_USERS_PASS=operador2026

# ---- Correo para recuperar contraseñas (elija UNA opción) ----
MAIL_FROM=Emergencias <no-reply@su-dominio.com>
# A) Resend (HTTPS; recomendado en Railway, que bloquea SMTP en planes Free/Hobby)
# RESEND_API_KEY=re_xxxxxxxx
# B) SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=usuario
# SMTP_PASSWORD=clave-de-aplicacion
# Sin ninguna: con DEBUG_MODE=True el enlace se imprime en la consola del backend.

# Límites anti-abuso (por conexión)
# LOGIN_MAX_FALLOS=5
# PUBLIC_MAX_REPORTES=5

# Carga ÚNICA de 100 incidentes de muestra + 3 usuarios (muestra.incidentes / muestra.flota / muestra.red)
# CARGAR_MUESTRA=True
# MUESTRA_PASS=una-clave-propia-de-10-o-mas-caracteres
