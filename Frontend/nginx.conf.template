server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Compresión: con mala señal el JS/CSS baja a una cuarta parte del tamaño.
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 500;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript text/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Los archivos con hash (assets/) pueden cachearse; index.html no.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
    }
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri /index.html;
    }
}
